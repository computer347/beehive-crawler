# Supabase (Project settings > API). The service role key is secret: never ship it to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# Optional: Claude enrichment of new listings (skills, degree fields, study year, languages, summary)
ANTHROPIC_API_KEY=
BEEHIVE_MODEL=claude-haiku-4-5-20251001

# Identify your crawler to the sites you visit
CRAWLER_CONTACT=you@example.com
